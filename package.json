    "@angular/compiler-cli": "^22.2.0",
    "@spartan-ng/cli": "^1.5.0",
    "@testing-library/angular": "^19.5.0",
    "@testing-library/dom": "^10.4.2",
    "@types/node": "^24.19.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
