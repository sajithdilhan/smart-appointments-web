{
  "name": "smart-appointments-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "ng": "ng",
    "start": "nx serve",
    "build": "nx build",
    "test": "nx test --watch=false",
    "test:watch": "nx test",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "size": "node scripts/size.mjs",
    "size:public": "node scripts/size.mjs --group public",
    "size:admin": "node scripts/size.mjs --group admin",
    "size:book": "node scripts/size.mjs --group book",
    "size:appointments": "node scripts/size.mjs --group appointments",
    "e2e": "playwright test",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "gen:api": "node scripts/gen-api.mjs",
    "test:scripts": "node --test \"scripts/*.spec.mjs\""
  },
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@ng-icons/core": ">=32.0.0 <34.0.0",
    "@ng-icons/lucide": ">=32.0.0 <34.0.0",
    "@ngrx/signals": "^22.0.1",
    "@spartan-ng/brain": "^1.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "ngx-sonner": "^3.1.0",
    "postcss": "^8.5.28",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.2.1",
    "@angular-devkit/schematics": "^22.2.1",
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@nx/angular": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@playwright/test": "^1.63.0",
    "@schematics/angular": "^22.2.1",
    "@spartan-ng/cli": "^1.5.0",
    "@testing-library/angular": "^19.5.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.2",
    "nx": "23.3.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sirv-cli": "^3.0.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0",
    "wait-on": "^9.5.1"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{css,json,md,yml,yaml}": "prettier --write"
  }
}
