{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@app/shared/layout/outage-banner": ["./src/app/shared/layout/outage-banner/index.ts"],
      "@app/shared/ui/alert": ["./src/app/shared/ui/alert/src/index.ts"],
      "@app/shared/ui/alert-dialog": ["./src/app/shared/ui/alert-dialog/src/index.ts"],
      "@app/shared/ui/badge": ["./src/app/shared/ui/badge/src/index.ts"],
      "@app/shared/ui/breadcrumb": ["./src/app/shared/ui/breadcrumb/src/index.ts"],
      "@app/shared/ui/button": ["./src/app/shared/ui/button/src/index.ts"],
      "@app/shared/ui/card": ["./src/app/shared/ui/card/src/index.ts"],
      "@app/shared/ui/dropdown-menu": ["./src/app/shared/ui/dropdown-menu/src/index.ts"],
      "@app/shared/ui/empty-state": ["./src/app/shared/ui/empty-state/index.ts"],
      "@app/shared/ui/inline-alert": ["./src/app/shared/ui/inline-alert/index.ts"],
      "@app/shared/ui/input": ["./src/app/shared/ui/input/src/index.ts"],
      "@app/shared/ui/label": ["./src/app/shared/ui/label/src/index.ts"],
      "@app/shared/ui/rate-limit-notice": ["./src/app/shared/ui/rate-limit-notice/index.ts"],
      "@app/shared/ui/separator": ["./src/app/shared/ui/separator/src/index.ts"],
      "@app/shared/ui/sheet": ["./src/app/shared/ui/sheet/src/index.ts"],
      "@app/shared/ui/skeleton": ["./src/app/shared/ui/skeleton/src/index.ts"],
      "@app/shared/ui/sonner": ["./src/app/shared/ui/sonner/src/index.ts"],
      "@app/shared/ui/switch": ["./src/app/shared/ui/switch/src/index.ts"],
      "@app/shared/ui/table": ["./src/app/shared/ui/table/src/index.ts"],
      "@app/shared/ui/textarea": ["./src/app/shared/ui/textarea/src/index.ts"],
      "@app/shared/ui/theme-toggle": ["./src/app/shared/ui/theme-toggle/index.ts"],
      "@app/shared/ui/utils": ["./src/app/shared/ui/utils/src/index.ts"],
      "@app/shared/ui/dialog": ["./src/app/shared/ui/dialog/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictTemplates": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
